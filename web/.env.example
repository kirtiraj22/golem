# Player onboarding / Supabase
# NEXT_PUBLIC_SUPABASE_URL is public. SUPABASE_SERVICE_ROLE_KEY is server-only
# and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Solana wallet UI/RPC settings. Connect/signMessage do not need an RPC
# endpoint, but the provider uses this endpoint for future game actions.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
GAME_AUTHORITY_SECRET_KEY=

# MagicBlock
MAGICBLOCK_ER_RPC_URL=
NEXT_PUBLIC_MAGICBLOCK_ER_RPC_URL=
NEXT_PUBLIC_MAGICBLOCK_VALIDATOR=